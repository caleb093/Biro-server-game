PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/birogame
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000
# Proxies in front of the server (Render: 3, local: 0). Defaults to 3 on Render.
TRUST_PROXY=0
